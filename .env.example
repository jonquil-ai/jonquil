# =======================================
# .env.example
# =======================================
# Copy this file as a ".env" 
# And fill it with your own values.
# =======================================


# === NETWORK SETTINGS === #
PORT=3000


# === AI PROVIDER SETTINGS === #
ACTIVE_PROVIDER=gemini

# Google AI
GEMINI_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.1-flash-lite

# Mistral AI
MISTRAL_KEY=YOUR_MISTRAL_API_KEY
MISTRAL_MODEL=mistral-large-latest


# === AI CORE SETTINGS === #
ENABLE_VISION=true # If set to false, no incoming media content will be sent to the AI ​​Provider. It can be disabled if the quota is limited or the model being used does not support the media content.
AI_MAX_CONTEXT_TOKENS=8000 # The maximum tokens of context (user messages, agent messages, tool calls).
AI_MAX_LOOPS=3 # The maximum number of loops an agent can create during tool calls and its thought process.


# === DEVELOPER SETTINGS === #
AI_DEBUG_MODE=true # If set to True, it displays the full context going to/coming from the AI ​​in the console.
MAX_LOG_LENGTH=5 # Maximum number of characters for messages in the logs