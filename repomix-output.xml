            if (thoughtMatch) {
                thought = thoughtMatch[1].trim();
                cleanText = cleanText.replace(/<thought>[\s\S]*?<\/thought>/, '').trim();
            }

            const msgDiv = document.createElement('div');
            msgDiv.className = 'flex items-start gap-3 max-w-2xl';

            let thoughtHtml = '';
            if (thought) {
                thoughtHtml = `
                    <details class="mb-3 bg-zinc-950/80 border border-zinc-800 rounded-xl overflow-hidden group">
                        <summary class="px-3 py-2 text-xs font-semibold text-amber-400/90 cursor-pointer hover:bg-zinc-900/50 flex items-center justify-between select-none">
                            <span class="flex items-center gap-1.5">🧠 AI Thought Process</span>
                            <span class="text-[10px] text-zinc-500 group-open:rotate-180 transition-transform">▼</span>
                        </summary>
                        <div class="p-3 text-xs font-mono text-zinc-400 border-t border-zinc-800/60 leading-relaxed whitespace-pre-wrap bg-zinc-950/40">
                            ${escapeHtml(thought)}
                        </div>
                    </details>
                `;
            }

            let actionsHtml = '';
            if (actions && actions.length > 0) {
                actionsHtml = actions.map(act => `
                    <div class="mt-2 p-2.5 rounded-lg bg-zinc-950 border border-zinc-800/80 text-xs font-mono text-amber-400 flex items-center gap-2">
                        <span>⚡ Action Executed:</span>
                        <span class="text-zinc-300 font-semibold">${escapeHtml(act.type)}</span>
                    </div>
                `).join('');
            }

            msgDiv.innerHTML = `
                <div class="w-8 h-8 rounded-lg bg-amber-400/10 border border-amber-400/20 flex items-center justify-center text-amber-400 shrink-0">
                    🌼
                </div>
                <div class="bg-zinc-900 border border-zinc-800 rounded-2xl rounded-tl-none p-4 text-sm text-zinc-200 shadow-sm flex-1">
                    ${thoughtHtml}
                    <div class="leading-relaxed whitespace-pre-wrap">${escapeHtml(cleanText || "(Action Executed)")}</div>
                    ${actionsHtml}
                </div>
            `;

            chatContainer.appendChild(msgDiv);
            scrollToBottom();
        }

        function appendSystemMessage(text) {
            const msgDiv = document.createElement('div');
            msgDiv.className = 'flex justify-center my-2';
            msgDiv.innerHTML = `
                <div class="bg-zinc-900/80 border border-zinc-800 text-zinc-400 text-xs px-3 py-1.5 rounded-full">
                    ${escapeHtml(text)}
                </div>
            `;
            chatContainer.appendChild(msgDiv);
            scrollToBottom();
        }

        function createTypingIndicator() {
            const indicatorDiv = document.createElement('div');
            indicatorDiv.id = 'typing-indicator';
            indicatorDiv.className = 'flex items-start gap-3 max-w-2xl';
            indicatorDiv.innerHTML = `
                <div class="w-8 h-8 rounded-lg bg-amber-400/10 border border-amber-400/20 flex items-center justify-center text-amber-400 shrink-0">
                    🌼
                </div>
                <div class="bg-zinc-900 border border-zinc-800 rounded-2xl rounded-tl-none px-4 py-3 text-sm text-zinc-400 flex items-center gap-1.5 shadow-sm">
                    <span class="w-2 h-2 bg-amber-400 rounded-full animate-bounce" style="animation-delay: 0ms"></span>
                    <span class="w-2 h-2 bg-amber-400 rounded-full animate-bounce" style="animation-delay: 150ms"></span>
                    <span class="w-2 h-2 bg-amber-400 rounded-full animate-bounce" style="animation-delay: 300ms"></span>
                    <span class="text-xs text-zinc-500 ml-2 font-mono">Jonquil is thinking...</span>
                </div>
            `;
            chatContainer.appendChild(indicatorDiv);
            scrollToBottom();
        }

        function removeTypingIndicator() {
            const indicator = document.getElementById('typing-indicator');
            if (indicator) indicator.remove();
        }

        function escapeHtml(str) {
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }

        async function sendMessage() {
            const text = messageInput.value.trim();
            if (!text) return;

            messageInput.value = '';
            messageInput.disabled = true;
            sendBtn.disabled = true;

            appendUserMessage(text);
            createTypingIndicator();

            try {
                const response = await fetch(API_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ text, sessionId: currentSessionId })
                });

                const data = await response.json();
                removeTypingIndicator();

                if (!response.ok || !data.success) {
                    appendSystemMessage(`⚠️ Error: ${data.error || 'Bağlantı hatası.'}`);
                } else if (data.reply.systemAction) {
                    if (data.reply.systemAction.includes('SHOW_TOS_PROMPT')) {
                        document.getElementById('tos-modal').classList.remove('hidden');
                        // Modal açılınca arkadaki input'u KİLİTLE!
                        messageInput.disabled = true;
                        sendBtn.disabled = true;
                    } else if (data.reply.systemAction === 'TOS_APPROVED_SUCCESS') {
                        appendSystemMessage("✅ Şartlar onaylandı. Sohbete başlayabilirsiniz!");
                    }
                } else if (data.reply.text) {
                    // NORMAL YAPAY ZEKA CEVABI
                    appendAssistantMessage(data.reply.text, data.reply.actions);
                }

            } catch (err) {
                removeTypingIndicator();
                appendSystemMessage('⚠️ Connection error. Is Web Gateway running on port 4000?');
            } finally {
                messageInput.disabled = false;
                sendBtn.disabled = false;
                messageInput.focus();
            }
        }

        sendBtn.addEventListener('click', sendMessage);
        messageInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') sendMessage();
        });

        messageInput.focus();

        async function acceptTos() {
            document.getElementById('tos-modal').classList.add('hidden');
            createTypingIndicator();
            
            try {
                // pure api call, no fake input injection
                const response = await fetch(API_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ text: "", sessionId: currentSessionId, systemEvent: "TOS_APPROVE" })
                });

                const data = await response.json();
                removeTypingIndicator();

                if (data.success && data.reply && data.reply.systemAction === 'TOS_APPROVED_SUCCESS') {
                    appendSystemMessage("✅ Terms accepted. You can now start chatting!");
                } else {
                    appendSystemMessage("⚠️ Failed to accept terms.");
                }
            } catch (err) {
                removeTypingIndicator();
                appendSystemMessage('⚠️ Connection error.');
            }
        }
        
    </script>
</body>
